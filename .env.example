# Copy to .env (never commit .env). These are local-only synthetic lab values.
# compose.yaml passes MSSQL_SA_PASSWORD to the SQL Server container.
# Host-run apps (API/CLI/tests) read the same variable from the process environment;
# scripts/bootstrap.ps1 loads it from .env into the session.
MSSQL_SA_PASSWORD=Lab_Local_2026!

# Host ports the lab containers publish on 127.0.0.1. Change these if the machine already
# runs SQL Server on 1433 or Redis on 6379; bootstrap.ps1 passes them to the app too.
DPL_SQL_PORT=1433
DPL_REDIS_PORT=6379

# Only for a second checkout on the same machine: a different compose project (so separate
# volumes) and container names (dpl-sql/dpl-redis by default). Leave unset otherwise.
# DPL_COMPOSE_PROJECT=dotnet-data-performance-lab-clone
# DPL_CONTAINER_PREFIX=dpl-clone
