# Build output
**/bin/
**/obj/

# IDE / tooling local state
.vs/
.idea/
.serena/
*.user
*.suo

# Test output
TestResults/
coverage/

# Local secrets - never commit real values
.env
.env.*
!.env.example
**/appsettings.Local.json

# Logs
*.log

# Generated data and local-only experiment output
data/generated/
results/local/

# Published measurement artifacts: keep the evidence, not the bulk.
# The raw k6 sample stream and the API's own log are large (tens of MB per comparison) and
# are regenerated by re-running. The summary, comparison, manifest, cache counters and the
# k6 run output are what a reader needs, and they are kept.
results/**/*.raw.json
results/**/*.api.log
results/**/*.api.err
!results/published/**/*.k6.log
!results/published/**/*.warmup.log
# The import package's per-scenario CLI logs are published evidence (manifest storage
# "published"); without this they fell under *.log and were never committed.
!results/published/**/import-scenarios/logs/*.log

# Local working notes (never published)
docs/plan/
